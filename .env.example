# Copiar a .env y completar. Nunca commitear secretos reales.

# PostgreSQL (obligatorio en producción / Reflex Cloud)
DATABASE_URL=postgresql+psycopg://polleria:polleria@localhost:5432/polleria

# Sembrar datos de demostración solo en desarrollo local (true/false)
SEED_DEMO=false

# URL pública de la app (links en emails de verificación y reset)
APP_BASE_URL=http://localhost:3000

# Gmail SMTP — usar contraseña de aplicación (no la contraseña normal)
# https://myaccount.google.com/apppasswords
GMAIL_USER=tu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=La Fábrica del Pollo
